# Resend API Key for sending emails (get yours at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient email where contact form submissions will be delivered
CONTACT_TO_EMAIL=khalidthenoble@gmail.com

# Sender email address
# Note: For free Resend test accounts, use "Portfolio Contact <onboarding@resend.dev>"
# Once you verify your custom domain in Resend, you can change this to "Portfolio Contact <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional secret key for HMAC captcha signing (defaults to RESEND_API_KEY if not specified)
CAPTCHA_SECRET=your_captcha_secret_salt_here

# Path or URL for the Weber AI model interface (defaults to /weber for same-domain serving)
NEXT_PUBLIC_WEBER_URL=/weber

# Weber AI Model Inference Backend (Phase 1: Fast cloud serving on open-source weights)
# Default recommendation: Groq (14,400 free requests/day at https://console.groq.com)
WEBER_MODEL_URL=https://api.groq.com/openai/v1
WEBER_MODEL_API_KEY=gsk_continue_your_secret_key_here
# Open-source model to serve (e.g. qwen/qwen3.8-27b or openai/gpt-oss-20b)
MODEL_NAME=qwen/qwen3.8-27b
# Maximum output generation tokens (defaults to 4096)
WEBER_MAX_TOKENS=4096
